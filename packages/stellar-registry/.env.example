DATABASE_URL=postgres://orloj:local-development-only@127.0.0.1:55432/orloj_stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Funded G address; reads use this account without signing.
SIMULATION_SOURCE=
WRITE_MODE=false
# Testnet only. Never put this value in policy, MCP arguments, or source control.
STELLAR_SIGNER_SECRET=
# Required to enable writes; fee in stroops, including resource fees.
MAX_FEE=2000000
STELLAR_POLICIES=[]
HOST=127.0.0.1
PORT=3002
# Required for CLI list/call/status. File contains bearer token, permissions 0600.
STELLAR_TOKEN_FILE=
POLL_TIMEOUT_MS=120000
SIM_TO_SUBMIT_MAX_AGE_MS=60000
RATE_LIMIT=60
